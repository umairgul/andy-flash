<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#112B4A"
                android:endColor="#234A7A"
                android:startColor="#07101D"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="50%"
                android:centerY="34%"
                android:endColor="#00FFD978"
                android:gradientRadius="44dp"
                android:startColor="#42FFE08A"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:bottom="50dp"
        android:left="18dp"
        android:right="18dp"
        android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFF5CF"
                android:startColor="#2FFFFFF0"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
